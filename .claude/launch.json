{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4340",
        "-d",
        "web"
      ],
      "port": 4340
    },
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/tools/local-server.mjs"
      ],
      "port": 4350
    },
    {
      "name": "app",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081,
      "cwd": "app"
    },
    {
      "name": "kula-app",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--port",
        "8082"
      ],
      "port": 8082,
      "cwd": "app"
    },
    {
      "name": "kula-ui",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node/dist/bin/kula-node.js",
        "ui",
        "--no-open"
      ],
      "port": 50590
    }
  ]
}
