{
  "name": "kula-desktop",
  "productName": "kula",
  "version": "0.3.0",
  "description": "kula's chat page as a desktop app for macOS and Windows",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "stage": "node tools/stage.mjs",
    "dist:mac": "node tools/stage.mjs && electron-builder --mac dmg --arm64",
    "dist:win": "node tools/stage.mjs && electron-builder --win nsis --x64",
    "app:mine": "node tools/stage.mjs && electron-builder --mac dir --arm64 -c.extraMetadata.kulaSource=\"$(cd ../node && pwd)\""
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.kula.desktop",
    "productName": "kula",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/kula-node",
        "to": "kula-node"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "afterPack": "tools/after-pack.cjs"
  }
}
