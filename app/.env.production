# kula decentralized ai — the live server for release builds (npm run apk). Public values:
# what protects the data is row-level security and the functions (backend/sql), not the key.
# Fill in kula's OWN Supabase project (never afterhours'): Settings → API → Project URL and
# the publishable (anon) key. tools/release-env.mjs checks them before every release build.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# optional: where shared links and posters point (a kula site, when there is one)
EXPO_PUBLIC_SITE_URL=
