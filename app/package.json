  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "film": "node tools/build-film.mjs",
    "shots": "node tools/store-shots.mjs",
    "passport:sync": "node tools/passport-core.mjs sync",
    "passport:check": "node tools/passport-core.mjs check",
    "release:check": "node tools/release-env.mjs",
    "apk": "node tools/apk.mjs",
    "i18n": "jest src/__tests__/i18n.test.ts --verbose",
    "coverage": "jest --coverage --collectCoverageFrom=src/llm/**/*.ts --collectCoverageFrom=src/night/**/*.ts --coverageReporters=text",
    "gate": "npx tsc --noEmit && npx expo lint && jest && npm run i18n"
  },
  "private": true,
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "resolver": "<rootDir>/jest.resolver.js"
  }
