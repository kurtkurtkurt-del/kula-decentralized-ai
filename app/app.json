{
  "expo": {
    "name": "kula decentralized ai",
    "slug": "pasaport",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.pasaport.ios",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "afterhours uses your location to show the nights near you.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.pasaport.android",
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kurtkurtkurt-del.github.io",
              "pathPrefix": "/afterhours/explore/event"
            },
            {
              "scheme": "https",
              "host": "kurtkurtkurt-del.github.io",
              "pathPrefix": "/afterhours/g"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./public/favicon.png",
      "output": "single",
      "name": "kula decentralized ai",
      "shortName": "kula",
      "description": "your phone's idle hours, lent to a project you choose.",
      "themeColor": "#F5F5F0",
      "backgroundColor": "#F5F5F0"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5F0",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "afterhours uses your location to show the nights near you."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "afterhours reads the passport of another device from its qr code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "afterhours shows the photo you choose at the top of your account.",
          "cameraPermission": "afterhours reads the passport of another device from its qr code.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#C86A51",
          "defaultChannel": "default"
        }
      ],
      "expo-apple-authentication",
      "expo-image"
    ],
    "scheme": "pasaport",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#F5F5F0",
    "description": "your phone's idle hours, lent to a project you choose.",
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "hidden": true
      },
      "eas": {
        "projectId": "34222e72-1878-4555-9293-daeaf33dfd88"
      }
    }
  }
}
