{
  "expo": {
    "name": "kula decentralized ai",
    "slug": "kula-decentralized-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.pasaport.ios",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "kula uses your location to place your phone in its city on the network.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "app.pasaport.android",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./public/favicon.png",
      "output": "single",
      "name": "kula decentralized ai",
      "shortName": "kula",
      "description": "your phone's idle hours, lent to a project you choose.",
      "themeColor": "#FFFFFF",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "kula uses your location to place your phone in its city on the network."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "kula reads the passport of another device from its qr code.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "kula shows the photo you choose at the top of your account.",
          "cameraPermission": "kula reads the passport of another device from its qr code.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#5B6B56",
          "defaultChannel": "default"
        }
      ],
      "expo-apple-authentication",
      "expo-image"
    ],
    "scheme": "pasaport",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#FFFFFF",
    "description": "your phone's idle hours, lent to a project you choose.",
    "extra": {
      "router": {},
      "expo-navigation-bar": {
        "hidden": true
      }
    }
  }
}
