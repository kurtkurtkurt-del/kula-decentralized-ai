<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
  <!-- "let my computers use this phone": the worker starts again after a restart (Keeper.kt) -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <application>
    <!-- The shared phone (worker). Own process: ggml's RPC server can't be stopped, so
         stopping the worker ends this process. -->
    <service
      android:name=".WorkerService"
      android:enabled="true"
      android:exported="false"
      android:process=":worker"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Lends this device's processor to the user's own AI model running across their devices" />
    </service>
    <!-- Ready by itself (Keeper.kt): boot and app update start the worker while "let my
         computers use this phone" is on (both actions are protected: only the system sends them). -->
    <receiver
      android:name=".KeeperReceiver"
      android:enabled="true"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
    <!-- the home wi-fi trigger: our own PendingIntent, so not exported -->
    <receiver
      android:name=".KeeperNetReceiver"
      android:enabled="true"
      android:exported="false" />
    <!-- the plug trigger and the 15 minute safety net -->
    <service
      android:name=".KeeperJob"
      android:exported="false"
      android:permission="android.permission.BIND_JOB_SERVICE" />
  </application>
</manifest>
