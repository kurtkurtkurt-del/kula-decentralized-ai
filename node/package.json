{
  "name": "kula-node",
  "version": "0.1.0",
  "description": "make this computer a worker in a kula phone cluster",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "kula-node": "dist/bin/kula-node.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "dev": "tsx src/bin/kula-node.ts",
    "pack": "node tools/pack.mjs",
    "pack:all": "node tools/pack.mjs --all",
    "manifests": "node tools/manifests.mjs"
  },
  "dependencies": {
    "bonjour-service": "^1.3.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
